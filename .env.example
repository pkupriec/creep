# Copy only for nonsecret local overrides; process environment wins over this file.
# External Ollama, with an already-installed text/function-tool capable model.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
CG_DATA_DIR=/data
# Optional. Supply CG_API_TOKEN in the process environment, not a committed file.
CG_API_TOKEN=
CG_MAX_PARALLEL_LLM=2
CG_MAX_ACTIVE_RUNS=4
CG_MAX_QUEUED_RUNS=20
CG_LLM_TIMEOUT_SECONDS=300
CG_RUN_ACTIVE_TIMEOUT_SECONDS=1800
CG_TOOL_WAIT_TIMEOUT_SECONDS=1800
CG_MAX_NODE_EXECUTIONS=100
CG_MAX_TOOL_ROUNDS=20
CG_HISTORY_RETENTION_DAYS=30
